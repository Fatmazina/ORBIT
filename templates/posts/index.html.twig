{% extends "base.html.twig" %}
{% block title %}Posts{% endblock %}
{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Posts</h2>
        {% if app.user %}
            <a href="{{ path('app_posts_create') }}" class="btn btn-primary">Create Post</a>
        {% endif %}
    </div>
    {% for p in posts %}
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex align-items-center mb-2">
                    <img src="{{ p.author.profileImage ?: asset('images/default-avatar.svg') }}" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px;">
                    <div>
                        <div class="fw-bold">{{ p.author.username }}</div>
                        <small class="text-muted">{{ p.createdAt|date('Y-m-d H:i') }} • in {{ p.category.name }}</small>
                    </div>
                </div>
                <h5 class="mb-2">{{ p.title }}</h5>
                <p class="mb-3">{{ p.content }}</p>
                <div class="d-flex align-items-center">
                    <a href="{{ path('app_posts_vote', { id: p.id, type: 'like' }) }}" class="btn btn-outline-success me-2">Like ({{ counts[p.id].like ?? 0 }})</a>
                    <a href="{{ path('app_posts_vote', { id: p.id, type: 'dislike' }) }}" class="btn btn-outline-danger me-3">Dislike ({{ counts[p.id].dislike ?? 0 }})</a>
                    <a href="{{ path('app_posts_show', { id: p.id }) }}" class="btn btn-link">Open</a>
                    <span class="ms-auto text-muted">{{ p.views }} views</span>
                </div>
            </div>
        </div>
    {% else %}
        <div class="alert alert-info">No posts yet.</div>
    {% endfor %}
</div>
{% endblock %}
