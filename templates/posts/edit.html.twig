{% extends "base.html.twig" %}
{% block title %}Edit Post{% endblock %}
{% block content %}
<div class="container mt-4">
    <h2 class="mb-3">Edit Post</h2>
    <form method="post" action="{{ path('app_posts_edit', { id: post.id }) }}" enctype="multipart/form-data">
        <input type="hidden" name="_token" value="{{ csrf_token('post_edit') }}">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" id="title" name="title" class="form-control" value="{{ post.title }}" required>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">Content</label>
            <textarea id="content" name="content" rows="6" class="form-control" required>{{ post.content }}</textarea>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Picture</label>
            <div id="image-error" class="alert alert-danger py-2 mb-2" style="display: none;"></div>
            {% if post.image %}
                <div class="mb-2">
                    <img src="{{ post.image }}" alt="Current image" class="img-thumbnail" style="max-height: 150px;">
                    <p class="small text-muted">Current image</p>
                </div>
            {% endif %}
            <input type="file" id="image" name="image" class="form-control" accept="image/*">
            <div class="form-text">Optional. Leave empty to keep the current image. Max 2MB (JPG, PNG, GIF, WEBP).</div>
        </div>
        <div class="mb-3">
            <label class="form-label">Categories</label>
            <div class="d-flex flex-wrap">
                {% for c in categories %}
                    <div class="form-check me-3 mb-2">
                        <input class="form-check-input" type="checkbox" id="edit_cat_{{ c.id }}" name="category_ids[]" value="{{ c.id }}" {% if c in post.categories %}checked{% endif %}>
                        <label class="form-check-label" for="edit_cat_{{ c.id }}">{{ c.name }}</label>
                    </div>
                {% endfor %}
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Update</button>
        <a href="{{ path('app_posts_show', { id: post.id }) }}" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const imageInput = document.getElementById('image');
    const imageError = document.getElementById('image-error');
    const updateBtn = document.querySelector('button[type="submit"]');
    const maxSize = 2 * 1024 * 1024; // 2MB

    function validateFile() {
        if (imageInput.files && imageInput.files[0]) {
            const file = imageInput.files[0];
            if (file.size > maxSize) {
                const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                imageError.innerHTML = `
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                        <div>
                            <strong>File too large!</strong><br>
                            Your file is ${sizeMB}MB. The maximum allowed is 2MB.<br>
                            Please choose a smaller image to continue.
                        </div>
                    </div>
                `;
                imageError.style.display = 'block';
                imageInput.classList.add('is-invalid');
                imageInput.value = ''; // Clear the file immediately
                updateBtn.disabled = true;
                return false;
            } else {
                imageError.style.display = 'none';
                imageInput.classList.remove('is-invalid');
                imageInput.classList.add('is-valid');
                updateBtn.disabled = false;
                return true;
            }
        }
        imageError.style.display = 'none';
        imageInput.classList.remove('is-invalid', 'is-valid');
        updateBtn.disabled = false;
        return true;
    }

    imageInput.addEventListener('change', validateFile);

    form.addEventListener('submit', function(e) {
        if (!validateFile()) {
            e.preventDefault();
            alert('Please select a smaller image (max 2MB) before updating.');
        }
    });
});
</script>
{% endblock %}
