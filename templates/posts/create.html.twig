{% extends "base.html.twig" %}
{% block title %}Create Post{% endblock %}
{% block content %}
<div class="container mt-4">
    <h2 class="mb-3">Create Post</h2>
    <form method="post" action="{{ path('app_posts_create') }}">
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input type="text" id="title" name="title" class="form-control" required>
        </div>
        <div class="mb-3">
            <label for="content" class="form-label">Content</label>
            <textarea id="content" name="content" rows="6" class="form-control" required></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Categories</label>
            <div class="d-flex flex-wrap">
                {% for c in categories %}
                    <div class="form-check me-3 mb-2">
                        <input class="form-check-input" type="checkbox" id="create_cat_{{ c.id }}" name="category_ids[]" value="{{ c.id }}">
                        <label class="form-check-label" for="create_cat_{{ c.id }}">{{ c.name }}</label>
                    </div>
                {% endfor %}
            </div>
        </div>
        <button type="submit" class="btn btn-primary">Publish</button>
        <a href="{{ path('app_posts') }}" class="btn btn-secondary ms-2">Cancel</a>
    </form>
{% endblock %}
