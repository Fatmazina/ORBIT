{% extends "base.html.twig" %}
{% block title %}{{ post.title }}{% endblock %}
{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">{{ post.title }}</h2>
        <div>
            <span class="badge bg-secondary">{{ post.views }} views</span>
            <span class="badge bg-success">{{ likes }} likes</span>
            <span class="badge bg-danger">{{ dislikes }} dislikes</span>
        </div>
    </div>
    <div class="d-flex align-items-center mb-2">
        <a href="{{ path('app_profile', { id: post.author.id }) }}">
            <img src="{{ post.author.profileImage ?: asset('images/default-avatar.svg') }}" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px;">
        </a>
        <p class="text-muted mb-0">by <a href="{{ path('app_profile', { id: post.author.id }) }}" class="text-decoration-none">{{ post.author.username }}</a> in {{ post.category.name }} • {{ post.createdAt|date('Y-m-d H:i') }}</p>
    </div>
    <div class="card mb-3">
        <div class="card-body">
            <p class="mb-0">{{ post.content }}</p>
        </div>
    </div>
    {% if app.user %}
        <div class="mb-3">
            <a href="{{ path('app_posts_vote', { id: post.id, type: 'like' }) }}" class="btn {{ userVote == 'like' ? 'btn-success' : 'btn-outline-success' }} me-2">Like</a>
            <a href="{{ path('app_posts_vote', { id: post.id, type: 'dislike' }) }}" class="btn {{ userVote == 'dislike' ? 'btn-danger' : 'btn-outline-danger' }}">Dislike</a>
        </div>
        {% if app.user.id == post.author.id %}
            <div class="mb-3">
                <a href="{{ path('app_posts_edit', { id: post.id }) }}" class="btn btn-warning me-2">Edit</a>
                <a href="{{ path('app_posts_delete', { id: post.id }) }}" class="btn btn-danger" onclick="return confirm('Delete this post?')">Delete</a>
            </div>
        {% endif %}
    {% endif %}
    <div>
        <a href="{{ path('app_posts') }}" class="btn btn-secondary">Back to posts</a>
    </div>
</div>
{% endblock %}
