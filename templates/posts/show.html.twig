{% extends "base.html.twig" %}
{% block title %}{{ post.title }}{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const voteForms = document.querySelectorAll('.vote-form');
    voteForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();

            {% if not app.user %}
                window.location.href = "{{ path('app_login') }}";
                return;
            {% endif %}

            const url = this.getAttribute('action');
            const formData = new FormData(this);
            const container = this.closest('.d-flex'); // For comment or post vote row
            
            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
                    .then(data => {
                        if (data.success) {
                            // Update counts in the current container
                            const likeCount = container.querySelector('.like-count');
                            if (likeCount) likeCount.textContent = `(${data.likes})`;
                            
                            const dislikeCount = container.querySelector('.dislike-count');
                            if (dislikeCount) dislikeCount.textContent = `(${data.dislikes})`;
                            
                            // Update icons active state
                            const likeIcon = container.querySelector('.vote-icon.like');
                            const dislikeIcon = container.querySelector('.vote-icon.dislike');
                            
                            if (likeIcon) {
                                if (data.userVote === 'like') {
                                    likeIcon.classList.add('bi-hand-thumbs-up-fill', 'text-primary');
                                    likeIcon.classList.remove('bi-hand-thumbs-up');
                                } else {
                                    likeIcon.classList.remove('bi-hand-thumbs-up-fill', 'text-primary');
                                    likeIcon.classList.add('bi-hand-thumbs-up');
                                }
                            }
                            if (dislikeIcon) {
                                if (data.userVote === 'dislike') {
                                    dislikeIcon.classList.add('bi-hand-thumbs-down-fill', 'text-danger');
                                    dislikeIcon.classList.remove('bi-hand-thumbs-down');
                                } else {
                                    dislikeIcon.classList.remove('bi-hand-thumbs-down-fill', 'text-danger');
                                    dislikeIcon.classList.add('bi-hand-thumbs-down');
                                }
                            }

                            // If it's a post vote, also update the top badges
                            if (form.classList.contains('post-vote-form')) {
                                const postLikeBadge = document.querySelector('.post-like-badge');
                                const postDislikeBadge = document.querySelector('.post-dislike-badge');
                                if (postLikeBadge) postLikeBadge.textContent = `${data.likes} likes`;
                                if (postDislikeBadge) postDislikeBadge.textContent = `${data.dislikes} dislikes`;
                            }
                        }
                    })
            .catch(error => console.error('Error:', error));
        });
    });
});
</script>
{% endblock %}
{% block content %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_posts') }}" class="text-decoration-none">Feed</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Post details</li>
                </ol>
            </nav>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-4">
                        <a href="{{ path('app_profile', { id: post.author.id }) }}">
                            <img src="{{ post.author.profileImage ?: asset('images/default-avatar.svg') }}" alt="Avatar" class="avatar-md me-3 border">
                        </a>
                        <div>
                            <div class="fw-bold">
                                <a href="{{ path('app_profile', { id: post.author.id }) }}" class="text-decoration-none text-dark">{{ post.author.username }}</a>
                                <span class="text-muted small fw-normal">posted an update</span>
                            </div>
                            <small class="text-muted">{{ post.createdAt|date('M d, Y • H:i') }} • 
                                {% for c in post.categories %}
                                    <span class="badge bg-light text-dark border-0">{{ c.name }}</span>
                                {% endfor %}
                            </small>
                        </div>
                        <div class="ms-auto">
                            <span class="text-muted small"><i class="bi bi-eye me-1"></i> {{ post.views }}</span>
                        </div>
                    </div>

                    <h2 class="fw-bold mb-3">{{ post.title }}</h2>
                    <p class="fs-5 mb-4" style="line-height: 1.6; color: var(--orbit-secondary);">{{ post.content }}</p>
                    
                    {% if post.image %}
                        <div class="mb-4">
                            <img src="{{ post.image }}" class="img-fluid rounded w-100 shadow-sm" style="max-height: 600px; object-fit: contain; background: #f8f9fa;" alt="{{ post.title }}">
                        </div>
                    {% endif %}

                    <hr class="text-muted opacity-10">

                    <div class="d-flex align-items-center">
                        {% set liked = app.user ? (userVote ?? null) == 'like' : false %}
                        {% set disliked = app.user ? (userVote ?? null) == 'dislike' : false %}
                        
                        <form action="{{ path('app_posts_vote', { id: post.id, type: 'like' }) }}" method="POST" class="d-inline vote-form post-vote-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('vote_post') }}">
                            <button type="submit" class="btn btn-link me-4 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted">
                                <i class="bi bi-hand-thumbs-up{{ liked ? '-fill text-primary' : '' }} vote-icon like fs-4 me-1"></i>
                                <span class="fw-bold like-count">({{ likes }})</span>
                            </button>
                        </form>

                        <form action="{{ path('app_posts_vote', { id: post.id, type: 'dislike' }) }}" method="POST" class="d-inline vote-form post-vote-form">
                            <input type="hidden" name="_token" value="{{ csrf_token('vote_post') }}">
                            <button type="submit" class="btn btn-link me-4 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted">
                                <i class="bi bi-hand-thumbs-down{{ disliked ? '-fill text-danger' : '' }} vote-icon dislike fs-4 me-1"></i>
                                <span class="fw-bold dislike-count">({{ dislikes }})</span>
                            </button>
                        </form>

                        <div class="text-muted d-flex align-items-center me-4">
                            <i class="bi bi-chat-left fs-4 me-1"></i>
                            <span class="fw-bold">{{ commentsCount }}</span>
                        </div>

                        {% if app.user and app.user.id == post.author.id %}
                            <div class="ms-auto d-flex gap-2">
                                <a href="{{ path('app_posts_edit', { id: post.id }) }}" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <form action="{{ path('app_posts_delete', { id: post.id }) }}" method="POST" onsubmit="return confirm('Delete this post?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_post') }}">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4" id="comments">
                <div class="card-body">
                    <h5 class="fw-bold mb-4">Comments ({{ commentsCount }})</h5>
                    
                    {% if app.user %}
                        <div class="d-flex mb-4">
                            <img src="{{ app.user.profileImage ?: asset('images/default-avatar.svg') }}" class="avatar-md me-3 border" alt="">
                            <form method="post" action="{{ path('app_posts_comment', { id: post.id }) }}" class="flex-grow-1">
                                <input type="hidden" name="_token" value="{{ csrf_token('add_comment') }}">
                                <textarea name="content" class="form-control border-0 bg-light rounded-4 mb-2 p-3" rows="3" placeholder="Write a comment..." required></textarea>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">Post Comment</button>
                                </div>
                            </form>
                        </div>
                    {% else %}
                        <div class="alert bg-light border-0 rounded-4 text-center py-4 mb-4">
                            <p class="text-muted mb-3">Join the conversation to share your thoughts!</p>
                            <a href="{{ path('app_login') }}" class="btn btn-primary rounded-pill px-4">Login to Comment</a>
                        </div>
                    {% endif %}

                    <div class="comment-list">
                        {% for c in comments %}
                            <div class="d-flex mb-4">
                                <a href="{{ path('app_profile', { id: c.author.id }) }}">
                                    <img src="{{ c.author.profileImage ?: asset('images/default-avatar.svg') }}" alt="Avatar" class="avatar-md me-3 border">
                                </a>
                                <div class="flex-grow-1 bg-light rounded-4 p-3 position-relative">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <div>
                                            <a href="{{ path('app_profile', { id: c.author.id }) }}" class="text-decoration-none text-dark fw-bold">{{ c.author.username }}</a>
                                            <small class="text-muted ms-2">{{ c.createdAt|date('M d, Y • H:i') }}</small>
                                        </div>
                                        
                                        {% set isCommentAuthor = app.user and app.user.id == c.author.id %}
                                        {% set isPostAuthor = app.user and app.user.id == post.author.id %}
                                        {% if isCommentAuthor or isPostAuthor %}
                                            <div class="dropdown">
                                                <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                                    <li>
                                                        <form action="{{ path('app_comments_delete', { postId: post.id, commentId: c.id }) }}" method="POST" onsubmit="return confirm('Delete this comment?')">
                                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_comment') }}">
                                                            <button type="submit" class="dropdown-item text-danger">Delete</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <p class="mb-2 text-secondary">{{ c.content }}</p>
                                    
                                    <div class="d-flex align-items-center">
                                        {% set cuv = app.user ? (commentUserVotes[c.id] ?? null) : null %}
                                        <form action="{{ path('app_comments_vote', { postId: post.id, commentId: c.id, type: 'like' }) }}" method="POST" class="d-inline vote-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote_comment') }}">
                                            <button type="submit" class="btn btn-link me-3 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted small">
                                                <i class="bi bi-hand-thumbs-up{{ cuv == 'like' ? '-fill text-primary' : '' }} vote-icon like me-1"></i>
                                                <span class="like-count">({{ commentCounts[c.id].like ?? 0 }})</span>
                                            </button>
                                        </form>
                                        <form action="{{ path('app_comments_vote', { postId: post.id, commentId: c.id, type: 'dislike' }) }}" method="POST" class="d-inline vote-form">
                                            <input type="hidden" name="_token" value="{{ csrf_token('vote_comment') }}">
                                            <button type="submit" class="btn btn-link me-3 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted small">
                                                <i class="bi bi-hand-thumbs-down{{ cuv == 'dislike' ? '-fill text-danger' : '' }} vote-icon dislike me-1"></i>
                                                <span class="dislike-count">({{ commentCounts[c.id].dislike ?? 0 }})</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-4">No comments yet. Be the first to join the conversation!</p>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="text-center mb-5">
                <a href="{{ path('app_posts') }}" class="btn btn-link text-decoration-none text-muted">
                    <i class="bi bi-arrow-left me-1"></i> Back to feed
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
