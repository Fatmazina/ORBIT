<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Orbit Forum{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <style>
            body {
                background-color: #f8f9fa;
            }
            .navbar-brand {
                font-weight: bold;
                font-size: 1.5rem;
            }
            .btn-link {
                text-decoration: none;
                color: #0d6efd;
            }
            .btn-link:hover {
                text-decoration: underline;
            }
            .card {
                border: none;
            }
            .vote-icon {
                font-size: 1.2rem;
                color: #6c757d;
                transition: color 0.2s;
            }
            .vote-icon.like.active {
                color: #0d6efd !important;
            }
            .vote-icon.dislike.active {
                color: #dc3545 !important;
            }
            .vote-count {
                color: #6c757d;
                font-weight: 500;
            }
            .btn-link:hover .vote-count {
                text-decoration: none;
            }
            .post-image-full {
                max-height: 500px;
                object-fit: contain;
                background-color: #f0f0f0;
            }
            .post-image-thumbnail {
                width: 100px;
                height: 100px;
                object-fit: cover;
                border-radius: 8px;
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        <!-- Navigation -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_home') }}">🚀 Orbit Forum</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_posts') }}">Explore</a>
                        </li>
                        {% if app.user %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_following') }}">Following</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_notifications') }}">
                                    <i class="bi bi-bell"></i>
                                    {% set unreadCount = app.user.notifications|filter(n => not n.isRead)|length %}
                                    {% if unreadCount > 0 %}
                                        <span class="badge rounded-pill bg-danger">{{ unreadCount }}</span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                    
                    <div class="d-flex flex-column flex-lg-row align-items-start align-items-lg-center mt-3 mt-lg-0">
                        <form class="d-none d-lg-flex mb-3 mb-lg-0 me-lg-3 w-100" action="{{ path('app_search') }}" method="GET" style="max-width: 300px;">
                            <div class="input-group input-group-sm">
                                <input class="form-control border-secondary bg-dark text-white" type="search" name="q" placeholder="Search..." aria-label="Search" value="{{ query|default('') }}">
                                <button class="btn btn-outline-secondary" type="submit">
                                    <i class="bi bi-search text-white"></i>
                                </button>
                            </div>
                        </form>

                        <ul class="navbar-nav align-items-center flex-row">
                            {% if app.user %}
                                <li class="nav-item me-3">
                                    <a class="nav-link p-0" href="{{ path('app_profile', {id: app.user.id}) }}" title="My Profile">
                                        <img src="{{ app.user.profileImage ?: asset('images/default-avatar.svg') }}" 
                                             alt="{{ app.user.username }}" 
                                             class="rounded-circle border border-secondary" 
                                             style="width: 35px; height: 35px; object-fit: cover;">
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('app_logout') }}">
                                        <i class="bi bi-box-arrow-right"></i> Logout
                                    </a>
                                </li>
                            {% else %}
                                <li class="nav-item me-3">
                                    <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link px-3 btn btn-outline-light btn-sm" href="{{ path('app_register') }}">Register</a>
                                </li>
                            {% endif %}
                        </ul>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Flash Messages -->
        <div class="container mt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <!-- Main Content -->
        <main>
            {% block content %}{% endblock %}
        </main>

        <!-- Footer -->
        <footer class="bg-dark text-white text-center py-4 mt-5">
            <div class="container">
                <p>&copy; 2025 Orbit Forum. All rights reserved.</p>
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
