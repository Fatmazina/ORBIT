<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Orbit Forum{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
        <style>
            :root {
                --orbit-bg: #f0f2f5;
                --orbit-card-bg: #ffffff;
                --orbit-primary: #26c2bc;
                --orbit-secondary: #3f4257;
                --orbit-text: #515365;
                --orbit-text-light: #888da8;
                --orbit-border: #e6ecf5;
            }
            body {
                background-color: var(--orbit-bg);
                color: var(--orbit-text);
                font-family: 'Roboto', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }
            .navbar {
                background-color: #ffffff !important;
                border-bottom: 1px solid var(--orbit-border);
                padding: 0.5rem 1rem;
            }
            .navbar-brand {
                color: var(--orbit-primary) !important;
                font-weight: 800;
                font-size: 1.5rem;
                display: flex;
                align-items: center;
            }
            .nav-icon {
                font-size: 1.4rem;
                color: #9a9fbf;
                padding: 0.5rem 1rem;
                transition: all 0.2s;
            }
            .nav-icon:hover, .nav-icon.active {
                color: #212529;
            }
            .search-bar {
                background-color: #f0f2f5;
                border: none;
                border-radius: 20px;
                padding: 0.5rem 1rem;
                font-size: 0.9rem;
            }
            .card {
                background-color: var(--orbit-card-bg);
                border: 1px solid var(--orbit-border);
                border-radius: 8px;
                box-shadow: 0 0 10px 0 rgba(0,0,0,0.02);
                margin-bottom: 20px;
            }
            .card-title {
                color: var(--orbit-secondary);
                font-weight: 700;
                font-size: 1rem;
            }
            .btn-primary {
                background-color: var(--orbit-primary);
                border-color: var(--orbit-primary);
            }
            .btn-primary:hover {
                background-color: #1e9c97;
                border-color: #1e9c97;
            }
            .vote-icon {
                font-size: 1.2rem;
                color: #6c757d;
                transition: color 0.2s;
            }
            .vote-icon.like.active {
                color: var(--orbit-primary) !important;
            }
            .vote-icon.dislike.active {
                color: #dc3545 !important;
            }
            .avatar-sm {
                width: 32px;
                height: 32px;
                object-fit: cover;
                border-radius: 50%;
            }
            .avatar-md {
                width: 40px;
                height: 40px;
                object-fit: cover;
                border-radius: 50%;
            }
            .avatar-lg {
                width: 100px;
                height: 100px;
                object-fit: cover;
                border-radius: 50%;
            }
            footer {
                background-color: #ffffff !important;
                color: var(--orbit-text-light) !important;
                border-top: 1px solid var(--orbit-border);
            }
        </style>
        {% block stylesheets %}{% endblock %}
    </head>
    <body>
        {% block header %}
            <!-- Navigation -->
            <nav class="navbar navbar-expand-lg navbar-light sticky-top">
                <div class="container-fluid">
                    <a class="navbar-brand py-0" href="{{ path('app_home') }}">
                        <img src="{{ asset('images/orbit.png') }}" alt="Orbit" height="40" class="d-inline-block align-text-top">
                    </a>
                    
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="collapse navbar-collapse" id="navbarNav">
                        <!-- Center Icons -->
                        <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                {% set is_explore = app.request.attributes.get('_route') == 'app_posts' %}
                                <a class="nav-link nav-icon {{ is_explore ? 'active' : '' }}" href="{{ path('app_posts') }}" title="Explore">
                                    <i class="bi bi-compass{{ is_explore ? '-fill' : '' }}"></i>
                                    <span class="d-lg-none ms-2">Explore</span>
                                </a>
                            </li>
                            {% if app.user %}
                                <li class="nav-item">
                                    {% set is_following = app.request.attributes.get('_route') == 'app_following' %}
                                    <a class="nav-link nav-icon {{ is_following ? 'active' : '' }}" href="{{ path('app_following') }}" title="Following">
                                        <i class="bi bi-people{{ is_following ? '-fill' : '' }}"></i>
                                        <span class="d-lg-none ms-2">Following</span>
                                    </a>
                                </li>
                                
                                <!-- Notifications (Mobile Only) -->
                                <li class="nav-item d-lg-none">
                                    {% set is_notif = app.request.attributes.get('_route') == 'app_notifications' %}
                                    <a class="nav-link nav-icon {{ is_notif ? 'active' : '' }}" href="{{ path('app_notifications') }}">
                                        <span class="position-relative">
                                            <i class="bi bi-bell{{ is_notif ? '-fill' : '' }}"></i>
                                            {% set unreadCount = app.user.notifications|filter(n => not n.isRead)|length %}
                                            {% if unreadCount > 0 %}
                                                <span class="position-absolute badge rounded-pill bg-danger" style="font-size: 0.55rem; top: -8px; right: -10px;">
                                                    {{ unreadCount }}
                                                </span>
                                            {% endif %}
                                        </span>
                                        <span class="ms-2">Notifications</span>
                                    </a>
                                </li>

                                {% if is_granted('ROLE_ADMIN') %}
                                    <li class="nav-item">
                                        {% set is_admin = app.request.attributes.get('_route') == 'app_admin_dashboard' %}
                                        <a class="nav-link nav-icon {{ is_admin ? 'active' : '' }}" href="{{ path('app_admin_dashboard') }}" title="Admin Dashboard">
                                            <i class="bi bi-shield-lock{{ is_admin ? '-fill' : '' }}"></i>
                                            <span class="d-lg-none ms-2">Admin Panel</span>
                                        </a>
                                    </li>
                                {% endif %}

                                <!-- Profile & Logout (Mobile Only) -->
                                <li class="nav-item d-lg-none">
                                    <a class="nav-link nav-icon" href="{{ path('app_profile', {id: app.user.id}) }}">
                                        <i class="bi bi-person"></i>
                                        <span class="ms-2">Profile</span>
                                    </a>
                                </li>
                                <li class="nav-item d-lg-none">
                                    <a class="nav-link nav-icon text-danger" href="{{ path('app_logout') }}">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span class="ms-2">Logout</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                        
                        <!-- Right side -->
                        <div class="d-flex align-items-center">
                            <form class="d-none d-lg-flex me-3" action="{{ path('app_search') }}" method="GET">
                                <div class="input-group input-group-sm">
                                    <input class="form-control search-bar" type="search" name="q" placeholder="Search Orbit..." aria-label="Search" value="{{ query|default('') }}">
                                </div>
                            </form>

                            {% if app.user %}
                                {% set is_notif = app.request.attributes.get('_route') == 'app_notifications' %}
                                <div class="dropdown me-2 d-none d-lg-block">
                                    <a class="nav-link nav-icon {{ is_notif ? 'active' : '' }}" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                                        <span class="position-relative">
                                            <i class="bi bi-bell{{ is_notif ? '-fill' : '' }}"></i>
                                            {% set unreadCount = app.user.notifications|filter(n => not n.isRead)|length %}
                                            {% if unreadCount > 0 %}
                                                <span class="position-absolute badge rounded-pill bg-danger" style="font-size: 0.55rem; top: -8px; right: -10px;">
                                                    {{ unreadCount }}
                                                </span>
                                            {% endif %}
                                        </span>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 p-0 overflow-hidden" style="width: 320px; max-height: 400px;">
                                        <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-light">
                                            <h6 class="mb-0 fw-bold small">Notifications</h6>
                                            {% if unreadCount > 0 %}
                                                <a href="{{ path('app_notifications_read_all') }}" class="small text-decoration-none" style="font-size: 0.75rem;">Mark all as read</a>
                                            {% endif %}
                                        </div>
                                        <div class="list-group list-group-flush overflow-auto" style="max-height: 300px;">
                                            {% for n in app.user.notifications|sort((a, b) => b.createdAt <=> a.createdAt)|slice(0, 10) %}
                                                <a href="{{ path('app_notification_read', {id: n.id}) }}" class="list-group-item list-group-item-action border-0 {{ not n.isRead ? 'bg-light' : '' }} py-2 px-3">
                                                    <div class="d-flex align-items-start">
                                                        <div class="me-2 mt-1">
                                                            {% if n.type == 'vote' %}
                                                                <i class="bi bi-hand-thumbs-up text-primary small"></i>
                                                            {% elseif n.type == 'comment' %}
                                                                <i class="bi bi-chat-text text-success small"></i>
                                                            {% elseif n.type == 'archive' %}
                                                                <i class="bi bi-exclamation-triangle text-danger small"></i>
                                                            {% elseif n.type == 'report' %}
                                                                <i class="bi bi-flag text-warning small"></i>
                                                            {% else %}
                                                                <i class="bi bi-bell text-secondary small"></i>
                                                            {% endif %}
                                                        </div>
                                                        <div class="flex-grow-1 min-width-0">
                                                            <p class="mb-0 small text-dark text-truncate-2 {{ not n.isRead ? 'fw-bold' : '' }}" style="line-height: 1.2; font-size: 0.85rem;">{{ n.message }}</p>
                                                            <small class="text-muted" style="font-size: 0.7rem;">{{ n.createdAt|date('M d, H:i') }}</small>
                                                        </div>
                                                        {% if not n.isRead %}
                                                            <div class="ms-2 mt-2">
                                                                <span class="badge bg-primary rounded-circle p-1" style="width: 6px; height: 6px;"><span class="visually-hidden">New</span></span>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </a>
                                            {% else %}
                                                <div class="text-center py-4">
                                                    <p class="text-muted mb-0 small">No notifications yet.</p>
                                                </div>
                                            {% endfor %}
                                        </div>
                                        <a href="{{ path('app_notifications') }}" class="dropdown-item text-center py-2 small text-primary border-top fw-bold" style="font-size: 0.8rem;">View All Notifications</a>
                                    </div>
                                </div>
                                <div class="dropdown d-none d-lg-block">
                                    <a class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <span class="me-2 d-none d-sm-inline fw-bold">{{ app.user.username }}</span>
                                        <img src="{{ app.user.profileImage ?: asset('images/default-avatar.svg') }}" 
                                             alt="{{ app.user.username }}" 
                                             class="avatar-sm border">
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <li><a class="dropdown-item text-dark fw-bold" href="{{ path('app_admin_dashboard') }}"><i class="bi bi-shield-lock me-2"></i> Admin Dashboard</a></li>
                                            <li><hr class="dropdown-divider"></li>
                                        {% endif %}
                                        <li><a class="dropdown-item" href="{{ path('app_profile', {id: app.user.id}) }}"><i class="bi bi-person me-2"></i> Profile</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item text-danger" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                                    </ul>
                                </div>
                            {% else %}
                                <a class="btn btn-link text-dark text-decoration-none me-2" href="{{ path('app_login') }}">Login</a>
                                <a class="btn btn-primary btn-sm px-3 rounded-pill" href="{{ path('app_register') }}">Register</a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </nav>
        {% endblock %}

        <!-- Flash Messages -->
        <div class="container mt-3">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <!-- Main Content -->
        <main>
            {% block content %}{% endblock %}
        </main>

        {% block footer %}
            <!-- Footer -->
            <footer class="bg-dark text-white text-center py-4 mt-5">
                <div class="container">
                    <p>&copy; 2025 Orbit Forum. All rights reserved.</p>
                </div>
            </footer>
        {% endblock %}

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
