{% extends 'base.html.twig' %}

{% block title %}Search Results - {{ query }}{% endblock %}

{% block content %}
<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex align-items-center mb-4">
                <h2 class="h3 mb-0 fw-bold">Search results for <span class="text-primary">"{{ query }}"</span></h2>
                <span class="badge bg-light text-dark border ms-3 rounded-pill px-3">{{ (users|length) + (posts|length) }} results</span>
            </div>

            <!-- Tabs Navigation -->
            <ul class="nav nav-tabs border-bottom-0 mb-4" id="searchTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-bold px-4" id="posts-tab" data-bs-toggle="tab" data-bs-target="#posts-pane" type="button" role="tab">
                        <i class="bi bi-file-text me-2"></i>Posts ({{ posts|length }})
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-bold px-4" id="users-tab" data-bs-toggle="tab" data-bs-target="#users-pane" type="button" role="tab">
                        <i class="bi bi-people me-2"></i>Users ({{ users|length }})
                    </button>
                </li>
            </ul>

            <!-- Tabs Content -->
            <div class="tab-content border-top pt-4" id="searchTabsContent">
                <!-- Posts Pane -->
                <div class="tab-pane fade show active" id="posts-pane" role="tabpanel">
                    {% for post in posts %}
                        <div class="card border-0 shadow-sm mb-3 hover-lift">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start mb-2">
                                    <div class="flex-grow-1">
                                        <h5 class="card-title h5 mb-1">
                                            <a href="{{ path('app_posts_show', {id: post.id}) }}" class="text-dark text-decoration-none fw-bold">
                                                {{ post.title }}
                                            </a>
                                        </h5>
                                        <div class="d-flex align-items-center text-muted small">
                                            <img src="{{ post.author.profileImage ?: asset('images/default-avatar.svg') }}" 
                                                 alt="{{ post.author.username }}" 
                                                 class="rounded-circle me-2" 
                                                 style="width: 20px; height: 20px; object-fit: cover;">
                                            <span class="me-2">{{ post.author.username }}</span>
                                            <span class="me-2">&bull;</span>
                                            <span>{{ post.createdAt|date('M d, Y') }}</span>
                                        </div>
                                    </div>
                                    <div class="ms-3">
                                        <span class="badge bg-light text-dark border rounded-pill">
                                            <i class="bi bi-chat-dots me-1"></i> {{ post.comments|length }}
                                        </span>
                                    </div>
                                </div>
                                <p class="card-text text-muted mb-0">
                                    {{ post.content|striptags|slice(0, 200) }}...
                                </p>
                            </div>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="bi bi-search text-muted opacity-25" style="font-size: 4rem;"></i>
                            <p class="mt-3 text-muted">No posts found matching your search.</p>
                        </div>
                    {% endfor %}
                </div>

                <!-- Users Pane -->
                <div class="tab-pane fade" id="users-pane" role="tabpanel">
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        {% for user in users %}
                            <div class="col">
                                <div class="card border-0 shadow-sm h-100 hover-lift">
                                    <div class="card-body d-flex align-items-center p-3">
                                        <img src="{{ user.profileImage ?: asset('images/default-avatar.svg') }}" 
                                             alt="{{ user.username }}" 
                                             class="rounded-circle border me-3" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0 fw-bold">
                                                <a href="{{ path('app_profile', {id: user.id}) }}" class="text-dark text-decoration-none">
                                                    {{ user.username }}
                                                </a>
                                            </h6>
                                            <p class="text-muted small mb-0">{{ user.bio|default('No bio yet.')|slice(0, 60) }}...</p>
                                            <div class="mt-1">
                                                <span class="text-muted" style="font-size: 0.75rem;">
                                                    Joined {{ user.createdAt|date('M Y') }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="ms-2">
                                            <a href="{{ path('app_profile', {id: user.id}) }}" class="btn btn-sm btn-outline-primary rounded-pill px-3">View</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12 text-center py-5">
                                <i class="bi bi-person-x text-muted opacity-25" style="font-size: 4rem;"></i>
                                <p class="mt-3 text-muted">No users found matching your search.</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="mt-5 border-top pt-4">
                <a href="{{ path('app_home') }}" class="btn btn-link text-muted text-decoration-none ps-0">
                    <i class="bi bi-arrow-left me-2"></i>Back to Feed
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .nav-tabs .nav-link {
        border: none;
        color: var(--orbit-text-light);
        border-bottom: 3px solid transparent;
        transition: all 0.2s;
    }
    .nav-tabs .nav-link:hover {
        color: var(--orbit-primary);
        border-bottom-color: var(--orbit-border);
    }
    .nav-tabs .nav-link.active {
        color: var(--orbit-primary);
        background: transparent;
        border-bottom: 3px solid var(--orbit-primary);
    }
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-3px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
    }
</style>
{% endblock %}
