{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Your Notifications</h2>
        {% set unreadCount = notifications|filter(n => not n.isRead)|length %}
        {% if unreadCount > 0 %}
            <a href="{{ path('app_notifications_read_all') }}" class="btn btn-sm btn-outline-primary">Mark all as read</a>
        {% endif %}
    </div>

    <div class="list-group">
        {% for n in notifications|sort((a, b) => b.createdAt <=> a.createdAt) %}
            <a href="{{ path('app_notification_read', {id: n.id}) }}" class="list-group-item list-group-item-action {{ not n.isRead ? 'bg-light' : '' }}">
                <div class="d-flex w-100 justify-content-between">
                    <div class="d-flex align-items-center">
                        <div class="me-3">
                            {% if n.type == 'vote' %}
                                <i class="bi bi-hand-thumbs-up text-primary fs-4"></i>
                            {% elseif n.type == 'comment' %}
                                <i class="bi bi-chat-text text-success fs-4"></i>
                            {% elseif n.type == 'archive' %}
                                <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                            {% elseif n.type == 'report' %}
                                <i class="bi bi-flag text-warning fs-4"></i>
                            {% else %}
                                <i class="bi bi-bell text-secondary fs-4"></i>
                            {% endif %}
                        </div>
                        <div>
                            <p class="mb-1 {{ not n.isRead ? 'fw-bold' : '' }}">{{ n.message }}</p>
                            <small class="text-muted">{{ n.createdAt|date('M d, Y H:i') }}</small>
                        </div>
                    </div>
                    {% if not n.isRead %}
                        <span class="badge bg-primary rounded-pill">New</span>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="text-center py-5">
                <i class="bi bi-bell-slash fs-1 text-muted"></i>
                <p class="mt-3 text-muted">No notifications yet.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
