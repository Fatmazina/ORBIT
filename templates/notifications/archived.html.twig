{% extends 'base.html.twig' %}

{% block title %}Notification{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="card shadow border-0 py-5 px-4">
                <div class="card-body">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-4">Notice from Administration</h2>
                    <div class="alert alert-light border p-4 mb-4">
                        <p class="lead mb-0">{{ message }}</p>
                    </div>
                    <p class="text-muted mb-4">
                        This content is no longer available as it has been moved to our archives by a moderator.
                    </p>
                    <a href="{{ path('app_posts') }}" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-2"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
