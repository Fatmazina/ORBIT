{% extends 'base.html.twig' %}

{% block title %}Orbit - Connect, Share, Grow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <style>
        :root {
            --landing-primary: #26c2bc;
            --landing-dark: #3f4257;
            --landing-light: #f8f9fa;
            --landing-gradient: linear-gradient(135deg, #26c2bc 0%, #1e9c97 100%);
        }

        body {
            overflow-x: hidden;
            background-color: #fff;
        }

        /* Custom Navbar */
        .landing-navbar {
            transition: all 0.3s ease;
            padding: 1.5rem 0;
            background: transparent !important;
            border-bottom: none !important;
        }

        .landing-navbar.scrolled {
            background: rgba(255, 255, 255, 0.95) !important;
            padding: 1rem 0;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            backdrop-filter: blur(10px);
        }

        /* Hero Section */
        .hero-section {
            padding: 180px 0 100px;
            background: radial-gradient(circle at 90% 10%, rgba(38, 194, 188, 0.1) 0%, transparent 40%),
                        radial-gradient(circle at 10% 90%, rgba(63, 66, 87, 0.05) 0%, transparent 40%);
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .hero-title {
            font-size: 4rem;
            font-weight: 800;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            color: var(--landing-dark);
        }

        .hero-title span {
            color: var(--landing-primary);
        }

        .text-primary {
            color: var(--landing-primary) !important;
        }

        .hero-subtitle {
            font-size: 1.25rem;
            color: #6c757d;
            margin-bottom: 2.5rem;
            max-width: 600px;
        }

        .btn-landing-primary {
            padding: 1rem 2.5rem;
            font-weight: 600;
            border-radius: 50px;
            background: var(--landing-gradient);
            color: #fff;
            border: none;
            box-shadow: 0 10px 20px rgba(38, 194, 188, 0.2);
            transition: all 0.3s ease;
        }

        .btn-landing-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 30px rgba(38, 194, 188, 0.3);
            color: #fff;
        }

        /* Floating Animation */
        .floating-ui {
            animation: floating 6s ease-in-out infinite;
            border-radius: 20px;
        }

        @keyframes floating {
            0% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
            100% { transform: translateY(0px); }
        }

        /* Feature Cards */
        .feature-card {
            padding: 3rem;
            border-radius: 24px;
            background: #fff;
            border: 1px solid #f1f1f1;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            height: 100%;
        }

        .feature-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.05);
            border-color: var(--landing-primary);
        }

        .feature-icon {
            width: 70px;
            height: 70px;
            background: rgba(38, 194, 188, 0.1);
            color: var(--landing-primary);
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin-bottom: 2rem;
        }

        /* Stats Section */
        .stats-section {
            background: var(--landing-dark);
            padding: 80px 0;
            color: #fff;
        }

        .stat-number {
            font-size: 3rem;
            font-weight: 800;
            color: var(--landing-primary);
        }

        /* Interactive Section */
        .interactive-preview {
            background: #f8f9fa;
            border-radius: 40px;
            padding: 100px 0;
            margin: 100px 0;
        }

        .preview-content {
            background: transparent;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .preview-content img {
            max-width: 60%;
            height: auto;
            object-fit: contain;
        }

        /* Footer */
        .landing-footer {
            padding: 100px 0 50px;
            background: #fff;
        }

        /* Smooth scroll indicator */
        .scroll-down {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            animation: bounce 2s infinite;
            color: var(--landing-primary);
            font-size: 1.5rem;
        }

        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0) translateX(-50%);}
            40% {transform: translateY(-10px) translateX(-50%);}
            60% {transform: translateY(-5px) translateX(-50%);}
        }
    </style>
{% endblock %}

{% block header %}
    <!-- Navbar Override -->
    <nav class="navbar navbar-expand-lg landing-navbar navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="#">
                <img src="{{ asset('images/orbit.png') }}" alt="Orbit Logo" height="40">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#landingNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="landingNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link px-3" href="{{ path('app_posts') }}">Explore</a></li>
                    <li class="nav-item"><a class="nav-link px-3" href="#features">Features</a></li>
                    <li class="nav-item"><a class="nav-link px-4 fw-bold" href="{{ path('app_login') }}">Login</a></li>
                    <li class="nav-item ms-lg-3">
                        <a href="{{ path('app_register') }}" class="btn btn-landing-primary">Join Now</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
{% endblock %}

{% block content %}
    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6" data-aos="fade-right" data-aos-duration="1000">
                    <h1 class="hero-title">Where <span>Creators</span> & Thinkers Orbit.</h1>
                    <p class="hero-subtitle">The modern platform for meaningful discussions, creative collaboration, and community growth. All in one place, all under your control.</p>
                    <div class="d-flex gap-3">
                        <a href="{{ path('app_register') }}" class="btn btn-landing-primary btn-lg">Start Your Journey</a>
                    </div>
                    <div class="mt-5 d-flex align-items-center">
                        
                        <span class="text-muted small">Joined by <strong>2,000+</strong> active members this month</span>
                    </div>
                </div>
                <div class="col-lg-6 mt-5 mt-lg-0" data-aos="zoom-in" data-aos-delay="200" data-aos-duration="1200">
                    <div class="position-relative">
                        <img src="{{ asset('images/back.png') }}" alt="Orbit Hero" class="img-fluid floating-ui">
                        <!-- Floating Badges -->
                        <div class="position-absolute bg-white p-3 rounded-4 shadow-lg floating-ui" style="top: -20px; right: -20px;" data-aos="fade-left" data-aos-delay="500">
                            <div class="d-flex align-items-center">
                                <div class="bg-success-subtle p-2 rounded-3 me-3">
                                    <i class="bi bi-lightning-charge-fill text-success"></i>
                                </div>
                                <div >
                                    <div class="fw-bold small  ">Fast Interactions</div>
                                    <div class="text-muted" style="font-size: 0.7rem;">Real-time updates</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="scroll-down">
            <i class="bi bi-chevron-down"></i>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-5 mt-5">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                {# <h6 class="text-primary fw-bold text-uppercase ls-2">Features</h6> #}
                <h2 class="display-5 fw-bold">Built for the next generation</h2>
                <p class="text-muted mx-auto" style="max-width: 600px;">Experience a forum that's as fast as your thoughts and as beautiful as your ideas.</p>
            </div>
            <div class="row g-4">
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-chat-quote"></i>
                        </div>
                        <h4>Smart Discussions</h4>
                        <p class="text-muted">Threaded conversations that keep context while allowing deep dives into any topic.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h4>Safe Spaces</h4>
                        <p class="text-muted">Advanced moderation tools and community guidelines ensure a healthy environment for everyone.</p>
                    </div>
                </div>
                <div class="col-md-4" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <i class="bi bi-graph-up-arrow"></i>
                        </div>
                        <h4>Growth Analytics</h4>
                        <p class="text-muted">Track your community's engagement and growth with built-in analytical tools.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Preview Section -->
    <section class="container" data-aos="fade-up">
        <div class="interactive-preview">
            <div class="row px-5 align-items-center">
                <div class="col-lg-5 mb-5 mb-lg-0">
                    <h2 class="display-6 fw-bold mb-4">Interactive & Engaging</h2>
                    <ul class="list-unstyled">
                        <li class="mb-4 d-flex">
                            <div class="me-3 text-primary"><i class="bi bi-check2-circle fs-4"></i></div>
                            <div>
                                <h5 class="fw-bold">Real-time Notifications</h5>
                                <p class="text-muted">Never miss a beat with instant alerts for likes, comments, and mentions.</p>
                            </div>
                        </li>
                        <li class="mb-4 d-flex">
                            <div class="me-3 text-primary"><i class="bi bi-check2-circle fs-4"></i></div>
                            <div>
                                <h5 class="fw-bold">Seamless Experience</h5>
                                <p class="text-muted">Switch between desktop and mobile without losing your place.</p>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-7">
                    <div class="preview-content" data-aos="zoom-in-left">
                        <img src="{{ asset('images/online.png') }}" alt="Community Interaction" class="img-fluid">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Stats Section -->
    <section class="stats-section">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-6 col-md-4">
                    <div class="stat-number">15k+</div>
                    <div class="text-uppercase small ls-1 opacity-75">Posts Daily</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="stat-number">50k+</div>
                    <div class="text-uppercase small ls-1 opacity-75">Users</div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="stat-number">24/7</div>
                    <div class="text-uppercase small ls-1 opacity-75">Active Moderation</div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block footer %}
    <!-- Footer -->
    <footer class="landing-footer">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <a class="navbar-brand mb-3 d-flex align-items-center" href="#">
                        <img src="{{ asset('images/orbit.png') }}" alt="Orbit Logo" height="40">
                    </a>
                    <p class="text-muted">The next generation platform for community engagement and creative collaboration.</p>
                    <div class="d-flex gap-3 mt-4">
                        <a href="#" class="text-dark fs-5"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-dark fs-5"><i class="bi bi-github"></i></a>
                        <a href="#" class="text-dark fs-5"><i class="bi bi-discord"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2 ms-auto">
                    <h6 class="fw-bold mb-4">Platform</h6>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><a href="{{ path('app_posts') }}" class="text-decoration-none text-muted">Discover</a></li>
                        <li class="mb-2"><a href="{{ path('app_posts') }}" class="text-decoration-none text-muted">Trending</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold mb-4">Company</h6>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">About Us</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Careers</a></li>
                        <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Privacy</a></li>
                    </ul>
                </div>
            </div>
            <hr class="opacity-10">
            <div class="text-center pt-4">
                <p class="text-muted small mb-0">&copy; 2026 Orbit Platform. All rights reserved.</p>
            </div>
        </div>
    </footer>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check if AOS is loaded
            if (typeof AOS !== 'undefined') {
                AOS.init({
                    duration: 800,
                    once: true,
                    offset: 100
                });
            }

            // Navbar scroll effect
            const navbar = document.querySelector('.landing-navbar');
            window.addEventListener('scroll', () => {
                if (window.scrollY > 50) {
                    navbar.classList.add('scrolled');
                } else {
                    navbar.classList.remove('scrolled');
                }
            });

            // Smooth scroll for anchors
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                });
            });
        });
    </script>
{% endblock %}
