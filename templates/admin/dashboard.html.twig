{% extends "base.html.twig" %}

{% block title %}Admin Dashboard{% endblock %}

{% block content %}
<div class="container mt-4">
    <h2 class="mb-3">Admin Dashboard</h2>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td>{{ u.id }}</td>
                            <td>{{ u.username }}</td>
                            <td>{{ u.email }}</td>
                            <td>{{ u.roles|join(', ') }}</td>
                            <td>{{ u.isActive ? 'Yes' : 'No' }}</td>
                            <td>
                                {% if u.isActive %}
                                    <a class="btn btn-sm btn-warning" href="{{ path('app_admin_block_user', { id: u.id }) }}">Block</a>
                                {% else %}
                                    <a class="btn btn-sm btn-success" href="{{ path('app_admin_activate_user', { id: u.id }) }}">Activate</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Categories</h5>
            <form method="post" action="{{ path('app_admin_add_category') }}" class="row g-3 mb-3">
                <div class="col-md-4">
                    <input type="text" name="name" class="form-control" placeholder="New category name" required>
                </div>
                <div class="col-md-6">
                    <input type="text" name="description" class="form-control" placeholder="Description (optional)">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Add</button>
                </div>
            </form>
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Created</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in categories %}
                        <tr>
                            <td>{{ c.id }}</td>
                            <td>{{ c.name }}</td>
                            <td>{{ c.description }}</td>
                            <td>{{ c.createdAt ? c.createdAt|date('Y-m-d H:i') : '' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-muted">No categories yet.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Archived Posts</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Archived At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for p in archivedPosts %}
                        <tr>
                            <td>{{ p.id }}</td>
                            <td>{{ p.title }}</td>
                            <td>{{ p.author.username }}</td>
                            <td>{{ p.archivedAt ? p.archivedAt|date('Y-m-d H:i') : '' }}</td>
                            <td>
                                <a href="{{ path('app_posts_show', { id: p.id }) }}" class="btn btn-sm btn-outline-secondary">View</a>
                                <a href="{{ path('app_posts_unarchive', { id: p.id }) }}" class="btn btn-sm btn-success ms-2" onclick="return confirm('Unarchive this post?')">Unarchive</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted">No archived posts.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="card mt-4">
        <div class="card-body">
            <h5 class="card-title">Archived Comments</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Author</th>
                        <th>Post</th>
                        <th>Excerpt</th>
                        <th>Archived At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for c in archivedComments %}
                        <tr>
                            <td>{{ c.id }}</td>
                            <td>{{ c.author.username }}</td>
                            <td>
                                <a href="{{ path('app_posts_show', { id: c.post.id }) }}">{{ c.post.title }}</a>
                            </td>
                            <td>{{ c.content|slice(0, 60) ~ (c.content|length > 60 ? '…' : '') }}</td>
                            <td>{{ c.archivedAt ? c.archivedAt|date('Y-m-d H:i') : '' }}</td>
                            <td>
                                <a href="{{ path('app_comments_unarchive', { postId: c.post.id, commentId: c.id }) }}" class="btn btn-sm btn-success" onclick="return confirm('Unarchive this comment?')">Unarchive</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">No archived comments.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">Back to home</a>
    </div>
</div>
{% endblock %}
