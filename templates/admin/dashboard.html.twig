{% extends "base.html.twig" %}

{% block title %}Admin Dashboard{% endblock %}

{% block content %}
<div class="container mt-4">
    <h2 class="mb-3">Admin Dashboard</h2>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
    <div class="card">
        <div class="card-body">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Roles</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                        <tr>
                            <td>{{ u.id }}</td>
                            <td>{{ u.username }}</td>
                            <td>{{ u.email }}</td>
                            <td>{{ u.roles|join(', ') }}</td>
                            <td>{{ u.isActive ? 'Yes' : 'No' }}</td>
                            <td>
                                {% if u.isActive %}
                                    <a class="btn btn-sm btn-warning" href="{{ path('app_admin_block_user', { id: u.id }) }}">Block</a>
                                {% else %}
                                    <a class="btn btn-sm btn-success" href="{{ path('app_admin_activate_user', { id: u.id }) }}">Activate</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">Back to home</a>
    </div>
</div>
{% endblock %}
