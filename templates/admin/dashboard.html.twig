{% extends "base.html.twig" %}

{% block title %}Admin Dashboard{% endblock %}

{% block stylesheets %}
<style>
    .admin-sidebar {
        min-height: calc(100vh - 56px);
        background: #212529;
        color: white;
    }
    .admin-nav-link {
        color: rgba(255,255,255,0.7);
        padding: 1rem 1.5rem;
        display: block;
        text-decoration: none;
        transition: all 0.3s;
        border-left: 4px solid transparent;
    }
    .admin-nav-link:hover, .admin-nav-link.active {
        color: white;
        background: rgba(255,255,255,0.1);
        border-left-color: #0d6efd;
    }
    .admin-nav-link i {
        margin-right: 10px;
        width: 20px;
    }
    .admin-content {
        padding: 1.5rem;
        background: #f8f9fa;
        min-height: calc(100vh - 56px);
    }
    .stat-card {
        border: none;
        border-radius: 10px;
        transition: transform 0.3s;
    }
    .stat-card:hover {
        transform: translateY(-5px);
    }
    .section-content {
        display: none;
    }
    .section-content.active {
        display: block;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 admin-sidebar shadow">
            <div class="py-4">
                <h5 class="px-4 mb-4 text-uppercase small fw-bold text-muted">Management</h5>
                <nav>
                    <a href="#analytics" class="admin-nav-link active" data-section="analytics">
                        <i class="bi bi-graph-up"></i> Analytics
                    </a>
                    <a href="#users" class="admin-nav-link" data-section="users">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a href="#posts" class="admin-nav-link" data-section="posts">
                        <i class="bi bi-file-earmark-text"></i> Archived Posts
                    </a>
                    <a href="#comments" class="admin-nav-link" data-section="comments">
                        <i class="bi bi-chat-left-text"></i> Archived Comments
                    </a>
                    <a href="#reports" class="admin-nav-link" data-section="reports">
                        <i class="bi bi-flag"></i> Reports 
                        {% if stats.pending_reports > 0 %}
                            <span class="badge bg-danger rounded-pill float-end">{{ stats.pending_reports }}</span>
                        {% endif %}
                    </a>
                    <a href="#categories" class="admin-nav-link" data-section="categories">
                        <i class="bi bi-tags"></i> Categories
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Analytics Section -->
            <div id="analytics" class="section-content active">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">Dashboard Overview</h2>
                    <span class="badge bg-light text-dark border">Real-time Data</span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card bg-primary text-white shadow-sm">
                            <div class="card-body p-3">
                                <h6 class="card-subtitle mb-1 small opacity-75">Total Users</h6>
                                <h3 class="card-title mb-0">{{ stats.users }}</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-success text-white shadow-sm">
                            <div class="card-body p-3">
                                <h6 class="card-subtitle mb-1 small opacity-75">Total Posts</h6>
                                <h3 class="card-title mb-0">{{ stats.posts }}</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-info text-white shadow-sm">
                            <div class="card-body p-3">
                                <h6 class="card-subtitle mb-1 small opacity-75">Total Comments</h6>
                                <h3 class="card-title mb-0">{{ stats.comments }}</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-warning text-dark shadow-sm">
                            <div class="card-body p-3">
                                <h6 class="card-subtitle mb-1 small opacity-75">Pending Reports</h6>
                                <h3 class="card-title mb-0">{{ stats.pending_reports }}</h3>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-7">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-3">
                                <h6 class="card-title mb-3 fw-bold text-muted small text-uppercase">User Registrations (Last 7 Days)</h6>
                                <div style="height: 180px;">
                                    <canvas id="registrationsChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-3">
                                <h6 class="card-title mb-3 fw-bold text-muted small text-uppercase">Posts by Category</h6>
                                <div style="height: 180px;">
                                    <canvas id="categoriesChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-3">
                                <h6 class="card-title mb-3 fw-bold text-muted small text-uppercase">Daily Engagement (Posts & Comments)</h6>
                                <div style="height: 180px;">
                                    <canvas id="engagementChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card shadow-sm border-0">
                            <div class="card-body p-3">
                                <h6 class="card-title mb-3 fw-bold text-muted small text-uppercase">User Verification Status</h6>
                                <div style="height: 180px;">
                                    <canvas id="verificationChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Section -->
            <div id="users" class="section-content">
                <h2 class="mb-4">User Management</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">User</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Joined</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for u in users %}
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-secondary rounded-circle me-3 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px;">
                                                        {{ u.username|slice(0, 1)|upper }}
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">{{ u.username }}</div>
                                                        <small class="text-muted">ID: #{{ u.id }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>{{ u.email }}</td>
                                            <td>
                                                {% if u.isActive %}
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Active</span>
                                                {% else %}
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Blocked</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ u.createdAt|date('Y-m-d') }}</td>
                                            <td class="pe-4">
                                                {% if u.isActive %}
                                                    <a class="btn btn-sm btn-outline-danger" href="{{ path('app_admin_block_user', { id: u.id }) }}">
                                                        <i class="bi bi-slash-circle me-1"></i> Block
                                                    </a>
                                                {% else %}
                                                    <a class="btn btn-sm btn-outline-success" href="{{ path('app_admin_activate_user', { id: u.id }) }}">
                                                        <i class="bi bi-check-circle me-1"></i> Activate
                                                    </a>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts Section -->
            <div id="posts" class="section-content">
                <h2 class="mb-4">Archived Posts</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Title</th>
                                        <th>Author</th>
                                        <th>Archived At</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in archivedPosts %}
                                        <tr>
                                            <td class="ps-4 fw-bold">{{ p.title }}</td>
                                            <td>{{ p.author.username }}</td>
                                            <td>{{ p.archivedAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4">
                                                <a href="{{ path('app_posts_show', { id: p.id }) }}" class="btn btn-sm btn-light border">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('app_posts_unarchive', { id: p.id }) }}" class="btn btn-sm btn-outline-success ms-2" onclick="return confirm('Unarchive this post?')">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">No archived posts.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comments Section -->
            <div id="comments" class="section-content">
                <h2 class="mb-4">Archived Comments</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Content Excerpt</th>
                                        <th>Author</th>
                                        <th>Archived At</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for c in archivedComments %}
                                        <tr>
                                            <td class="ps-4">{{ c.content|slice(0, 80) }}...</td>
                                            <td>{{ c.author.username }}</td>
                                            <td>{{ c.archivedAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4">
                                                <a href="{{ path('app_comments_unarchive', { postId: c.post.id, commentId: c.id }) }}" class="btn btn-sm btn-outline-success" onclick="return confirm('Unarchive this comment?')">
                                                    <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">No archived comments.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reports Section -->
            <div id="reports" class="section-content">
                <h2 class="mb-4">Reports Queue</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Reported Item</th>
                                        <th>Reporter</th>
                                        <th>Reason</th>
                                        <th>Date</th>
                                        <th class="pe-4 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for r in reports %}
                                        <tr>
                                            <td class="ps-4">
                                                {% if r.reportedPost %}
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">Post</span>
                                                    <div class="fw-bold">{{ r.reportedPost.title }}</div>
                                                {% elseif r.reportedComment %}
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle mb-1">Comment</span>
                                                    <div class="text-muted small">{{ r.reportedComment.content|slice(0, 50) }}...</div>
                                                {% endif %}
                                            </td>
                                            <td>{{ r.reporter.username }}</td>
                                            <td><span class="text-danger">{{ r.reason }}</span></td>
                                            <td>{{ r.createdAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4 text-end">
                                                <div class="btn-group btn-group-sm">
                                                    {% if r.reportedPost %}
                                                        <a href="{{ path('app_posts_show', { id: r.reportedPost.id }) }}" class="btn btn-primary" title="Review Content">
                                                            <i class="bi bi-eye"></i> Review
                                                        </a>
                                                    {% elseif r.reportedComment %}
                                                        <a href="{{ path('app_posts_show', { id: r.reportedComment.post.id }) }}" class="btn btn-primary" title="Review Content">
                                                            <i class="bi bi-eye"></i> Review
                                                        </a>
                                                    {% endif %}
                                                    <a href="{{ path('app_admin_resolve_report', { id: r.id }) }}" class="btn btn-success" title="Mark as Resolved">
                                                        <i class="bi bi-check-lg"></i>
                                                    </a>
                                                    <a href="{{ path('app_admin_dismiss_report', { id: r.id }) }}" class="btn btn-outline-secondary" title="Dismiss Report">
                                                        <i class="bi bi-x-lg"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">No pending reports.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Section -->
            <div id="categories" class="section-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Category Management</h2>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                        <i class="bi bi-plus-lg me-2"></i> Add New Category
                    </button>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Name</th>
                                        <th>Description</th>
                                        <th>Created</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for c in categories %}
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">{{ c.name }}</td>
                                            <td>{{ c.description|default('No description') }}</td>
                                            <td>{{ c.createdAt|date('Y-m-d') }}</td>
                                            <td class="pe-4">
                                                <button class="btn btn-sm btn-light border"><i class="bi bi-pencil"></i></button>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" action="{{ path('app_admin_add_category') }}">
                <div class="modal-header">
                    <h5 class="modal-title">Add New Category</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Category Name</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Category</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Section Switching Logic
        const navLinks = document.querySelectorAll('.admin-nav-link');
        const sections = document.querySelectorAll('.section-content');

        function showSection(sectionId) {
            sections.forEach(s => s.classList.remove('active'));
            navLinks.forEach(l => l.classList.remove('active'));
            
            const targetSection = document.getElementById(sectionId);
            const targetLink = document.querySelector(`[data-section="${sectionId}"]`);
            
            if (targetSection && targetLink) {
                targetSection.classList.add('active');
                targetLink.classList.add('active');
                
                // If reports section is opened, mark them as seen
                if (sectionId === 'reports') {
                    const badge = targetLink.querySelector('.badge');
                    if (badge) {
                        badge.remove();
                        fetch('{{ path("app_admin_reports_mark_seen") }}', {
                            method: 'POST',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });
                    }
                }
            }
        }

        navLinks.forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const sectionId = this.getAttribute('data-section');
                showSection(sectionId);
                window.location.hash = sectionId;
            });
        });

        // Handle direct hash links
        if (window.location.hash) {
            showSection(window.location.hash.substring(1));
        }

        // Charts
        try {
            const regData = {{ chartData.registrations|json_encode|raw }};
            const catData = {{ chartData.categories|json_encode|raw }};
            const engData = {{ chartData.engagement|json_encode|raw }};
            const verData = {{ chartData.verification|json_encode|raw }};

            // Registration Chart
            const regCtx = document.getElementById('registrationsChart');
            if (regCtx) {
                new Chart(regCtx, {
                    type: 'line',
                    data: {
                        labels: regData.map(d => d.date),
                        datasets: [{
                            label: 'Registrations',
                            data: regData.map(d => d.count),
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13, 110, 253, 0.1)',
                            fill: true,
                            tension: 0.4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } }, x: { ticks: { font: { size: 10 } } } }
                    }
                });
            }

            // Category Chart
            const catCtx = document.getElementById('categoriesChart');
            if (catCtx) {
                new Chart(catCtx, {
                    type: 'doughnut',
                    data: {
                        labels: catData.map(d => d.name),
                        datasets: [{
                            data: catData.map(d => d.count),
                            backgroundColor: ['#0d6efd', '#198754', '#0dcaf0', '#ffc107', '#dc3545', '#6610f2']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'right',
                                labels: { boxWidth: 10, font: { size: 10 } }
                            } 
                        }
                    }
                });
            }

            // Engagement Chart
            const engCtx = document.getElementById('engagementChart');
            if (engCtx) {
                new Chart(engCtx, {
                    type: 'bar',
                    data: {
                        labels: engData.map(d => d.date),
                        datasets: [
                            {
                                label: 'Posts',
                                data: engData.map(d => d.posts),
                                backgroundColor: '#0d6efd'
                            },
                            {
                                label: 'Comments',
                                data: engData.map(d => d.comments),
                                backgroundColor: '#198754'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { position: 'top', labels: { boxWidth: 10, font: { size: 10 } } } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 10 } } }, x: { ticks: { font: { size: 10 } } } }
                    }
                });
            }

            // Verification Chart
            const verCtx = document.getElementById('verificationChart');
            if (verCtx) {
                new Chart(verCtx, {
                    type: 'pie',
                    data: {
                        labels: verData.map(d => d.status),
                        datasets: [{
                            data: verData.map(d => d.count),
                            backgroundColor: ['#198754', '#dc3545']
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'right',
                                labels: { boxWidth: 10, font: { size: 10 } }
                            } 
                        }
                    }
                });
            }
        } catch (e) {
            console.error('Chart error:', e);
        }
    });
</script>
{% endblock %}
