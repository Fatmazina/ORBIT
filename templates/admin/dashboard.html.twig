{% extends "base.html.twig" %}

{% block title %}Admin Dashboard{% endblock %}

{% block stylesheets %}
<style>
    .admin-sidebar {
        min-height: calc(100vh - 56px);
        background: #ffffff;
        color: #333;
        transition: all 0.3s ease;
        z-index: 1000;
        border-right: 1px solid #eee;
    }
    
    @media (max-width: 767.98px) {
        .admin-sidebar {
            position: fixed;
            left: -250px;
            width: 250px;
            height: 100%;
        }
        .admin-sidebar.show {
            left: 0;
        }
        .admin-content {
            width: 100% !important;
        }
        .sidebar-toggle {
            display: flex !important;
        }
    }

    .sidebar-toggle {
        display: none;
        position: fixed;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        background: #ffffff;
        color: #333;
        width: 30px;
        height: 60px;
        align-items: center;
        justify-content: center;
        border-radius: 0 10px 10px 0;
        cursor: pointer;
        z-index: 1001;
        transition: all 0.3s ease;
        border: 1px solid #eee;
        border-left: none;
    }
    
    .sidebar-toggle.active {
        left: 250px;
    }
    
    .sidebar-toggle i {
        transition: transform 0.3s ease;
    }
    
    .sidebar-toggle.active i {
        transform: rotate(180deg);
    }

    .admin-nav-link {
        color: #666;
        padding: 1rem 1.5rem;
        display: block;
        text-decoration: none;
        transition: all 0.3s;
        border-left: 4px solid transparent;
        font-weight: 500;
    }
    .admin-nav-link:hover, .admin-nav-link.active {
        color: #000;
        background: #f8f9fa;
        border-left-color: #00d2ff;
    }
    .admin-nav-link i {
        margin-right: 10px;
        width: 20px;
    }
    .admin-content {
        padding: 2rem;
        background: #fdfdfd;
        min-height: calc(100vh - 56px);
    }
    .stat-card {
        border: none;
        border-radius: 15px;
        transition: transform 0.3s, box-shadow 0.3s;
        overflow: hidden;
        position: relative;
    }
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }
    .stat-card .card-body {
        z-index: 1;
        position: relative;
    }
    .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(45deg, rgba(255,255,255,0.1), transparent);
    }

    .bg-gradient-cyan { background: linear-gradient(135deg, #00d2ff 0%, #3a7bd5 100%); }
    .bg-gradient-purple { background: linear-gradient(135deg, #8e2de2 0%, #4a00e0 100%); }
    .bg-gradient-pink { background: linear-gradient(135deg, #ff0099 0%, #493240 100%); }
    .bg-gradient-orange { background: linear-gradient(135deg, #f09819 0%, #edde5d 100%); }

    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .section-content {
        display: none;
    }
    .section-content.active {
        display: block;
        animation: fadeIn 0.5s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .chart-container {
        position: relative;
        margin: auto;
    }
    
    .table thead th {
        background-color: #f8f9fa;
        border-bottom: none;
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
        color: #888;
        padding: 1rem;
    }
    .table tbody td {
        padding: 1rem;
        border-bottom: 1px solid #f1f1f1;
    }
    .badge-subtle {
        padding: 0.5em 1em;
        border-radius: 8px;
        font-weight: 500;
    }
</style>
{% endblock %}

{% block content %}
<div class="sidebar-toggle" id="sidebarToggle">
    <i class="bi bi-chevron-right"></i>
</div>

<div class="container-fluid p-0">
    <div class="row g-0">
        <!-- Sidebar -->
        <div class="col-md-3 col-lg-2 admin-sidebar shadow" id="adminSidebar">
            <div class="py-4">
                <h5 class="px-4 mb-4 text-uppercase small fw-bold text-muted">Management</h5>
                <nav>
                    <a href="#analytics" class="admin-nav-link active" data-section="analytics">
                        <i class="bi bi-graph-up"></i> Analytics
                    </a>
                    <a href="#users" class="admin-nav-link" data-section="users">
                        <i class="bi bi-people"></i> Users
                    </a>
                    <a href="#posts" class="admin-nav-link" data-section="posts">
                        <i class="bi bi-file-earmark-text"></i> Archived Posts
                    </a>
                    <a href="#comments" class="admin-nav-link" data-section="comments">
                        <i class="bi bi-chat-left-text"></i> Archived Comments
                    </a>
                    <a href="#reports" class="admin-nav-link" data-section="reports">
                        <i class="bi bi-flag"></i> Reports 
                        {% if stats.pending_reports > 0 %}
                            <span class="badge bg-danger rounded-pill float-end">{{ stats.pending_reports }}</span>
                        {% endif %}
                    </a>
                    <a href="#categories" class="admin-nav-link" data-section="categories">
                        <i class="bi bi-tags"></i> Categories
                    </a>
                </nav>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 col-lg-10 admin-content">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            <!-- Analytics Section -->
            <div id="analytics" class="section-content active">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h4 mb-0">Dashboard Overview</h2>
                    <span class="badge bg-light text-dark border">Real-time Data</span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card stat-card bg-gradient-cyan text-white shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="card-subtitle mb-0 small text-uppercase opacity-75">Total Users</h6>
                                    <i class="bi bi-people fs-4"></i>
                                </div>
                                <h2 class="card-title mb-0 fw-bold">{{ stats.users }}</h2>
                                <div class="mt-2 small opacity-75">
                                    <i class="bi bi-arrow-up"></i> 12% from last month
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-gradient-purple text-white shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="card-subtitle mb-0 small text-uppercase opacity-75">Total Posts</h6>
                                    <i class="bi bi-file-earmark-text fs-4"></i>
                                </div>
                                <h2 class="card-title mb-0 fw-bold">{{ stats.posts }}</h2>
                                <div class="mt-2 small opacity-75">
                                    <i class="bi bi-arrow-up"></i> 5% from last month
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-gradient-pink text-white shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="card-subtitle mb-0 small text-uppercase opacity-75">Total Comments</h6>
                                    <i class="bi bi-chat-left-text fs-4"></i>
                                </div>
                                <h2 class="card-title mb-0 fw-bold">{{ stats.comments }}</h2>
                                <div class="mt-2 small opacity-75">
                                    <i class="bi bi-arrow-up"></i> 8% from last month
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card stat-card bg-gradient-orange text-white shadow-sm">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="card-subtitle mb-0 small text-uppercase opacity-75">Pending Reports</h6>
                                    <i class="bi bi-flag fs-4"></i>
                                </div>
                                <h2 class="card-title mb-0 fw-bold">{{ stats.pending_reports }}</h2>
                                <div class="mt-2 small opacity-75">
                                    {{ stats.pending_reports > 0 ? 'Requires attention' : 'All clear' }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Main Analytics Row -->
                <div class="row g-4 mb-4">
                    <div class="col-md-8">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <h6 class="card-title mb-0 fw-bold text-muted small text-uppercase">User Registrations (Last 7 Days)</h6>
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border-0" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item small" href="#">Export Data</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div style="height: 250px;">
                                    <canvas id="registrationsChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body p-4">
                                <h6 class="card-title mb-4 fw-bold text-muted small text-uppercase">User Verification</h6>
                                <div style="height: 200px;" class="mb-4">
                                    <canvas id="verificationChart"></canvas>
                                </div>
                                <div class="mt-4 pt-2 border-top">
                                    <div class="d-flex justify-content-between mb-2 small">
                                        <span>Verified Users</span>
                                        <span class="fw-bold text-primary">{{ chartData.verification[0].count }}</span>
                                    </div>
                                    <div class="d-flex justify-content-between small">
                                        <span>Unverified Users</span>
                                        <span class="fw-bold text-muted">{{ chartData.verification[1].count }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-7">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body p-4">
                                <h6 class="card-title mb-4 fw-bold text-muted small text-uppercase">Daily Engagement</h6>
                                <div style="height: 250px;">
                                    <canvas id="engagementChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body p-4">
                                <h6 class="card-title mb-4 fw-bold text-muted small text-uppercase">Posts by Category</h6>
                                <div style="height: 250px;">
                                    <canvas id="categoriesChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Users Section -->
            <div id="users" class="section-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">User Management</h2>
                    <form action="{{ path('app_admin_dashboard') }}#users" method="get" class="d-flex gap-2" id="userSearchForm">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="q" class="form-control border-start-0 ps-0" placeholder="Search name or email..." value="{{ app.request.query.get('q') }}">
                        </div>
                        <button type="submit" class="btn btn-primary">Search</button>
                        {% if app.request.query.get('q') %}
                            <a href="{{ path('app_admin_dashboard') }}#users" class="btn btn-outline-secondary">Clear</a>
                        {% endif %}
                    </form>
                </div>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">User</th>
                                        <th>Email</th>
                                        <th>Status</th>
                                        <th>Joined</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for u in users %}
                                        <tr>
                                            <td class="ps-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-secondary rounded-circle me-3 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px;">
                                                        {{ u.username|slice(0, 1)|upper }}
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold">{{ u.username }}</div>
                                                        <small class="text-muted">ID: #{{ u.id }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>{{ u.email }}</td>
                                            <td>
                                                {% if u.isActive %}
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3">Active</span>
                                                {% else %}
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3">Blocked</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ u.createdAt|date('Y-m-d') }}</td>
                                            <td class="pe-4">
                                                {% if u.isActive %}
                                                    <form action="{{ path('app_admin_block_user', { id: u.id }) }}" method="POST" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Block this user?')">
                                                            <i class="bi bi-slash-circle me-1"></i> Block
                                                        </button>
                                                    </form>
                                                {% else %}
                                                    <form action="{{ path('app_admin_activate_user', { id: u.id }) }}" method="POST" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('user_action') }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-check-circle me-1"></i> Activate
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">
                                                <i class="bi bi-people mb-3 d-block" style="font-size: 2rem;"></i>
                                                No users found matching your search.
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Posts Section -->
            <div id="posts" class="section-content">
                <h2 class="mb-4">Archived Posts</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Title</th>
                                        <th>Author</th>
                                        <th>Archived At</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for p in archivedPosts %}
                                        <tr>
                                            <td class="ps-4 fw-bold">{{ p.title }}</td>
                                            <td>{{ p.author.username }}</td>
                                            <td>{{ p.archivedAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4 d-flex align-items-center">
                                                <a href="{{ path('app_posts_show', { id: p.id }) }}" class="btn btn-sm btn-light border me-2">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <form action="{{ path('app_posts_unarchive', { id: p.id }) }}" method="POST" onsubmit="return confirm('Unarchive this post?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('unarchive_post') }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">No archived posts.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comments Section -->
            <div id="comments" class="section-content">
                <h2 class="mb-4">Archived Comments</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Content Excerpt</th>
                                        <th>Author</th>
                                        <th>Archived At</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for c in archivedComments %}
                                        <tr>
                                            <td class="ps-4">{{ c.content|slice(0, 80) }}...</td>
                                            <td>{{ c.author.username }}</td>
                                            <td>{{ c.archivedAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4">
                                                <form action="{{ path('app_comments_unarchive', { postId: c.post.id, commentId: c.id }) }}" method="POST" onsubmit="return confirm('Unarchive this comment?')">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('unarchive_comment') }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-success">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center py-5 text-muted">No archived comments.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Reports Section -->
            <div id="reports" class="section-content">
                <h2 class="mb-4">Reports Queue</h2>
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Reported Item</th>
                                        <th>Reporter</th>
                                        <th>Reason</th>
                                        <th>Date</th>
                                        <th class="pe-4 text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for r in reports %}
                                        <tr>
                                            <td class="ps-4">
                                                {% if r.reportedPost %}
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1">Post</span>
                                                    <div class="fw-bold">{{ r.reportedPost.title }}</div>
                                                {% elseif r.reportedComment %}
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle mb-1">Comment</span>
                                                    <div class="text-muted small">{{ r.reportedComment.content|slice(0, 50) }}...</div>
                                                {% endif %}
                                            </td>
                                            <td>{{ r.reporter.username }}</td>
                                            <td><span class="text-danger">{{ r.reason }}</span></td>
                                            <td>{{ r.createdAt|date('Y-m-d H:i') }}</td>
                                            <td class="pe-4 text-end">
                                                <div class="d-flex justify-content-end gap-2">
                                                    {% if r.reportedPost %}
                                                        <a href="{{ path('app_posts_show', { id: r.reportedPost.id }) }}" class="btn btn-sm btn-light border rounded-pill px-3" title="Review Content">
                                                            <i class="bi bi-eye me-1"></i> Review
                                                        </a>
                                                    {% elseif r.reportedComment %}
                                                        <a href="{{ path('app_posts_show', { id: r.reportedComment.post.id }) }}" class="btn btn-sm btn-light border rounded-pill px-3" title="Review Content">
                                                            <i class="bi bi-eye me-1"></i> Review
                                                        </a>
                                                    {% endif %}
                                                    
                                                    <form action="{{ path('app_admin_archive_report', { id: r.id }) }}" method="POST">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('report_action') }}">
                                                        <button type="submit" class="btn btn-sm btn-warning rounded-pill px-3 d-flex align-items-center" onclick="return confirm('Archive this content and resolve the report?')">
                                                            <i class="bi bi-archive me-1"></i> Archive
                                                        </button>
                                                    </form>
                                                    
                                                    <form action="{{ path('app_admin_resolve_report', { id: r.id }) }}" method="POST">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('report_action') }}">
                                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 d-flex align-items-center">
                                                            <i class="bi bi-check-circle me-1"></i> Resolve
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="text-center py-5 text-muted">No pending reports.</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Categories Section -->
            <div id="categories" class="section-content">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2>Category Management</h2>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                        <i class="bi bi-plus-lg me-2"></i> Add New Category
                    </button>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">Name</th>
                                        <th>Description</th>
                                        <th>Created</th>
                                        <th class="pe-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for c in categories %}
                                        <tr>
                                            <td class="ps-4 fw-bold text-primary">{{ c.name }}</td>
                                            <td>{{ c.description|default('No description') }}</td>
                                            <td>{{ c.createdAt|date('Y-m-d') }}</td>
                                            <td class="pe-4">
                                                <button class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#editCategoryModal{{ c.id }}">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form action="{{ path('app_admin_delete_category', { id: c.id }) }}" method="POST" class="d-inline ms-2">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_category') }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this category?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>

                                        <!-- Edit Category Modal -->
                                        <div class="modal fade" id="editCategoryModal{{ c.id }}" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content text-dark">
                                                    <form method="post" action="{{ path('app_admin_edit_category', { id: c.id }) }}">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('edit_category') }}">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Edit Category: {{ c.name }}</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Category Name</label>
                                                                <input type="text" name="name" class="form-control" value="{{ c.name }}" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Description</label>
                                                                <textarea name="description" class="form-control" rows="3">{{ c.description }}</textarea>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Save Changes</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

