{% extends "base.html.twig" %}

{% block title %}Profile{% endblock %}

{% block content %}
<div class="container mt-4">
    <h2 class="mb-3">Profile</h2>
    <div class="card">
        <div class="card-body">
            {% if profileUser.profileImage %}
                <div class="mb-3">
                    <img src="{{ profileUser.profileImage }}" alt="Profile Image" class="img-thumbnail" style="max-height: 150px;">
                </div>
            {% endif %}
            <p class="mb-1"><strong>Username:</strong> {{ profileUser.username }}</p>
            <p class="mb-1"><strong>Email:</strong> {{ profileUser.email }}</p>
            {% if profileUser.bio %}
                <p class="mb-1"><strong>Bio:</strong> {{ profileUser.bio }}</p>
            {% endif %}
        </div>
    </div>
    <div class="mt-3">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">Back to home</a>
        {% if app.user and app.user.id == profileUser.id %}
            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary ms-2">Edit Profile</a>
        {% endif %}
    </div>
    <div class="mt-4">
        <h3 class="mb-3">Posts by {{ profileUser.username }}</h3>
        {% if posts is defined and posts|length > 0 %}
            {% for p in posts %}
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <img src="{{ profileUser.profileImage ?: asset('images/default-avatar.svg') }}" alt="Avatar" class="rounded-circle me-2" style="width: 40px; height: 40px;">
                            <div>
                                <div class="fw-bold">{{ profileUser.username }}</div>
                                <small class="text-muted">{{ p.createdAt|date('Y-m-d H:i') }} • in 
                                    {% for c in p.categories %}
                                        {% if not loop.first %}, {% endif %}{{ c.name }}
                                    {% endfor %}
                                </small>
                            </div>
                        </div>
                        <h5 class="mb-2">{{ p.title }}</h5>
                        <p class="mb-3">{{ p.content }}</p>
                        <div class="d-flex align-items-center">
                            {% set liked = app.user ? (userVotes[p.id] ?? null) == 'like' : false %}
                            {% set disliked = app.user ? (userVotes[p.id] ?? null) == 'dislike' : false %}
                            <form action="{{ path('app_posts_vote', { id: p.id, type: 'like', from: 'profile', profileId: profileUser.id }) }}" method="POST" class="vote-form d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('vote' ~ p.id) }}">
                                <button type="submit" class="btn btn-link p-0 me-3 d-flex align-items-center text-decoration-none">
                                {% if liked %}
                                    <i class="bi bi-hand-thumbs-up-fill active vote-icon like"></i>
                                {% else %}
                                    <i class="bi bi-hand-thumbs-up vote-icon like"></i>
                                {% endif %}
                                    <span class="ms-1 vote-count like-count">({{ counts[p.id].like ?? 0 }})</span>
                                </button>
                            </form>
                            <form action="{{ path('app_posts_vote', { id: p.id, type: 'dislike', from: 'profile', profileId: profileUser.id }) }}" method="POST" class="vote-form d-inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('vote' ~ p.id) }}">
                                <button type="submit" class="btn btn-link p-0 me-3 d-flex align-items-center text-decoration-none">
                                {% if disliked %}
                                    <i class="bi bi-hand-thumbs-down-fill active vote-icon dislike"></i>
                                {% else %}
                                    <i class="bi bi-hand-thumbs-down vote-icon dislike"></i>
                                {% endif %}
                                    <span class="ms-1 vote-count dislike-count">({{ counts[p.id].dislike ?? 0 }})</span>
                                </button>
                            </form>
                            <a href="{{ path('app_posts_show', { id: p.id }) }}" class="btn btn-link">Open</a>
                            <span class="ms-auto text-muted">{{ p.views }} views</span>
                        </div>
                        {% if app.user and app.user.id == profileUser.id %}
                            <div class="mt-2">
                                <a href="{{ path('app_posts_edit', { id: p.id }) }}" class="text-warning text-decoration-none me-3" aria-label="Edit">
                                    <i class="bi bi-pencil-fill fs-5"></i>
                                </a>
                                <a href="{{ path('app_posts_delete', { id: p.id, from: 'profile' }) }}" class="text-danger text-decoration-none" aria-label="Delete" onclick="return confirm('Delete this post?')">
                                    <i class="bi bi-trash-fill fs-5"></i>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="alert alert-info">No posts yet.</div>
        {% endif %}
    </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const voteForms = document.querySelectorAll('.vote-form');
    voteForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const url = this.getAttribute('action');
            const formData = new FormData(this);
            const container = this.closest('.d-flex');
            
            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    // Update counts
                    const likeCount = container.querySelector('.like-count');
                    if (likeCount) likeCount.textContent = `(${data.likes})`;
                    
                    const dislikeCount = container.querySelector('.dislike-count');
                    if (dislikeCount) dislikeCount.textContent = `(${data.dislikes})`;
                    
                    // Update icons active state
                    const likeIcon = container.querySelector('.vote-icon.like');
                    const dislikeIcon = container.querySelector('.vote-icon.dislike');
                    
                    if (likeIcon) {
                        if (data.userVote === 'like') {
                            likeIcon.classList.add('active', 'bi-hand-thumbs-up-fill');
                            likeIcon.classList.remove('bi-hand-thumbs-up');
                        } else {
                            likeIcon.classList.remove('active', 'bi-hand-thumbs-up-fill');
                            likeIcon.classList.add('bi-hand-thumbs-up');
                        }
                    }
                    if (dislikeIcon) {
                        if (data.userVote === 'dislike') {
                            dislikeIcon.classList.add('active', 'bi-hand-thumbs-down-fill');
                            dislikeIcon.classList.remove('bi-hand-thumbs-down');
                        } else {
                            dislikeIcon.classList.remove('active', 'bi-hand-thumbs-down-fill');
                            dislikeIcon.classList.add('bi-hand-thumbs-down');
                        }
                    }
                }
            })
            .catch(error => console.error('Error:', error));
        });
    });
});
</script>
{% endblock %}
