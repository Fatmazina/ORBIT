{% extends "base.html.twig" %}

{% block title %}Profile{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Profile Header -->
            <div class="card shadow-sm border-0 mb-4 overflow-hidden">
                <div style="height: 150px; background: linear-gradient(135deg, #26c2bc 0%, #2575fc 100%);"></div>
                <div class="card-body pt-0 px-4">
                    <div class="d-flex align-items-end mb-4" style="margin-top: -50px;">
                        <img src="{{ profileUser.profileImage ?: asset('images/default-avatar.svg') }}" 
                             alt="{{ profileUser.username }}" 
                             class="rounded-circle border border-4 border-white shadow-sm bg-white" 
                             style="width: 120px; height: 120px; object-fit: cover;">
                        <div class="ms-4 mb-2 flex-grow-1">
                            <h3 class="fw-bold mb-0 text-dark">{{ profileUser.username }}</h3>
                            <p class="text-muted small mb-0">{{ profileUser.email }}</p>
                        </div>
                        <div class="mb-2">
                            {% if app.user and app.user.id == profileUser.id %}
                                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary rounded-pill px-4">Edit Profile</a>
                            {% else %}
                                {% if app.user %}
                                    {% if app.user.isFollowing(profileUser) %}
                                        <form action="{{ path('app_user_unfollow', { id: profileUser.id }) }}" method="POST">
                                            <button type="submit" class="btn btn-outline-danger rounded-pill px-4">Unfollow</button>
                                        </form>
                                    {% else %}
                                        <form action="{{ path('app_user_follow', { id: profileUser.id }) }}" method="POST">
                                            <button type="submit" class="btn btn-primary rounded-pill px-4">Follow</button>
                                        </form>
                                    {% endif %}
                                {% else %}
                                    <a href="{{ path('app_login') }}" class="btn btn-primary rounded-pill px-4">Follow</a>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>

                    {% if profileUser.bio %}
                        <div class="mb-4">
                            <h6 class="fw-bold text-muted small text-uppercase">About</h6>
                            <p class="text-secondary mb-0">{{ profileUser.bio }}</p>
                        </div>
                    {% endif %}

                    <div class="d-flex gap-4 border-top pt-3">
                        <div class="text-center">
                            <div class="fw-bold text-dark">{{ profileUser.followers|length }}</div>
                            <div class="text-muted small">Followers</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold text-dark">{{ profileUser.following|length }}</div>
                            <div class="text-muted small">Following</div>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold text-dark">{{ posts|length }}</div>
                            <div class="text-muted small">Posts</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Profile Posts -->
            <h5 class="fw-bold mb-4 mt-5">Posts by {{ profileUser.username }}</h5>
            
            <div class="row">
                <div class="col-lg-8">
                    {% for p in posts %}
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-3">
                                    <img src="{{ profileUser.profileImage ?: asset('images/default-avatar.svg') }}" class="avatar-md me-2 border" alt="">
                                    <div>
                                        <div class="fw-bold text-dark">{{ profileUser.username }}</div>
                                        <small class="text-muted">{{ p.createdAt|date('M d, Y') }} • 
                                            {% for c in p.categories %}
                                                <span class="badge bg-light text-dark border-0">{{ c.name }}</span>
                                            {% endfor %}
                                        </small>
                                    </div>
                                    <div class="ms-auto dropdown">
                                        <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                            <li><a class="dropdown-item" href="{{ path('app_posts_show', {id: p.id}) }}">View Post</a></li>
                                            {% if app.user and app.user.id == profileUser.id %}
                                                <li><a class="dropdown-item" href="{{ path('app_posts_edit', {id: p.id}) }}">Edit</a></li>
                                            {% endif %}
                                        </ul>
                                    </div>
                                </div>
                                
                                <h5 class="card-title mb-2"><a href="{{ path('app_posts_show', {id: p.id}) }}" class="text-decoration-none text-dark">{{ p.title }}</a></h5>
                                <p class="text-secondary mb-3">{{ p.content|slice(0, 200) }}{{ p.content|length > 200 ? '...' : '' }}</p>
                                
                                <div class="d-flex align-items-center">
                                    {% set liked = app.user ? (userVotes[p.id] ?? null) == 'like' : false %}
                                    {% set disliked = app.user ? (userVotes[p.id] ?? null) == 'dislike' : false %}
                                    
                                    <form action="{{ path('app_posts_vote', { id: p.id, type: 'like', from: 'profile', profileId: profileUser.id }) }}" method="POST" class="d-inline vote-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vote_post') }}">
                                        <button type="submit" class="btn btn-link me-4 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted small">
                                            <i class="bi bi-hand-thumbs-up{{ liked ? '-fill text-primary' : '' }} vote-icon like fs-5 me-1"></i>
                                            <span class="like-count">({{ counts[p.id].like ?? 0 }})</span>
                                        </button>
                                    </form>

                                    <form action="{{ path('app_posts_vote', { id: p.id, type: 'dislike', from: 'profile', profileId: profileUser.id }) }}" method="POST" class="d-inline vote-form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('vote_post') }}">
                                        <button type="submit" class="btn btn-link me-4 p-0 d-flex align-items-center text-decoration-none border-0 bg-transparent text-muted small">
                                            <i class="bi bi-hand-thumbs-down{{ disliked ? '-fill text-danger' : '' }} vote-icon dislike fs-5 me-1"></i>
                                            <span class="dislike-count">({{ counts[p.id].dislike ?? 0 }})</span>
                                        </button>
                                    </form>

                                    <a href="{{ path('app_posts_show', { id: p.id }) }}#comments" class="text-muted text-decoration-none small d-flex align-items-center">
                                        <i class="bi bi-chat-left fs-5 me-1"></i>
                                        <span>Comment</span>
                                    </a>

                                    <div class="ms-auto text-muted small">
                                        <i class="bi bi-eye me-1"></i> {{ p.views }} views
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="card card-body text-center py-5 shadow-sm">
                            <i class="bi bi-journals fs-1 text-muted mb-3"></i>
                            <p class="text-muted">No posts by this user yet.</p>
                        </div>
                    {% endfor %}
                </div>
                
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h6 class="card-title mb-3">Member info</h6>
                            <ul class="list-unstyled small mb-0">
                                <li class="mb-2 d-flex align-items-center text-muted">
                                    <i class="bi bi-calendar3 me-2 text-primary"></i>
                                    Joined {{ profileUser.createdAt|date('M Y') }}
                                </li>
                                <li class="d-flex align-items-center text-muted">
                                    <i class="bi bi-geo-alt me-2 text-primary"></i>
                                    Global Community
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const voteForms = document.querySelectorAll('.vote-form');
    voteForms.forEach(form => {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            {% if not app.user %}
                window.location.href = "{{ path('app_login') }}";
                return;
            {% endif %}
            
            const url = this.getAttribute('action');
            const formData = new FormData(this);
            const container = this.closest('.d-flex');
            
            fetch(url, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            })
            .then(response => {
                if (!response.ok) throw new Error('Network response was not ok');
                return response.json();
            })
                    .then(data => {
                        if (data.success) {
                            // Update counts
                            const likeCount = container.querySelector('.like-count');
                            if (likeCount) likeCount.textContent = `(${data.likes})`;
                            
                            const dislikeCount = container.querySelector('.dislike-count');
                            if (dislikeCount) dislikeCount.textContent = `(${data.dislikes})`;
                            
                            // Update icons active state
                            const likeIcon = container.querySelector('.vote-icon.like');
                            const dislikeIcon = container.querySelector('.vote-icon.dislike');
                            
                            if (likeIcon) {
                                if (data.userVote === 'like') {
                                    likeIcon.classList.add('bi-hand-thumbs-up-fill', 'text-primary');
                                    likeIcon.classList.remove('bi-hand-thumbs-up');
                                } else {
                                    likeIcon.classList.remove('bi-hand-thumbs-up-fill', 'text-primary');
                                    likeIcon.classList.add('bi-hand-thumbs-up');
                                }
                            }
                            if (dislikeIcon) {
                                if (data.userVote === 'dislike') {
                                    dislikeIcon.classList.add('bi-hand-thumbs-down-fill', 'text-danger');
                                    dislikeIcon.classList.remove('bi-hand-thumbs-down');
                                } else {
                                    dislikeIcon.classList.remove('bi-hand-thumbs-down-fill', 'text-danger');
                                    dislikeIcon.classList.add('bi-hand-thumbs-down');
                                }
                            }
                        }
                    })
            .catch(error => console.error('Error:', error));
        });
    });
});
</script>
{% endblock %}
