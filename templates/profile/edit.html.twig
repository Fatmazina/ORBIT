{% extends "base.html.twig" %}

{% block title %}Edit Profile{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">Edit Profile</h2>
                    <form method="post" action="{{ path('app_profile_edit') }}" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="username" class="form-label">Username</label>
                            <input type="text" name="username" id="username" class="form-control" value="{{ user.username }}" required>
                        </div>
                        <div class="mb-3">
                            <label for="bio" class="form-label">Bio</label>
                            <textarea name="bio" id="bio" class="form-control" rows="4">{{ user.bio }}</textarea>
                        </div>
                        <div class="mb-3">
                            <label for="profile_image" class="form-label">Profile Image</label>
                            <div class="mb-2">
                                <img src="{{ user.profileImage ?: asset('images/default-avatar.svg') }}" alt="Profile Image" class="img-thumbnail rounded-circle" style="max-height: 120px; width: 120px; height: 120px; object-fit: cover;">
                            </div>
                            <div id="image-error" class="alert alert-danger py-2 mb-2" style="display: none;"></div>
                            <input type="file" name="profile_image" id="profile_image" class="form-control" accept="image/*">
                            <div class="form-text">Maximum size: 2MB (JPG, PNG, GIF, WEBP)</div>
                        </div>
                        <hr class="my-4">
                        <h5 class="mb-3">Change Password</h5>
                        <div class="mb-3">
                            <label for="new_password" class="form-label">New Password</label>
                            <input type="password" name="new_password" id="new_password" class="form-control">
                        </div>
                        <div class="mb-3">
                            <label for="confirm_password" class="form-label">Confirm New Password</label>
                            <input type="password" name="confirm_password" id="confirm_password" class="form-control">
                        </div>
                        <button type="submit" class="btn btn-primary w-100 mb-3">Save Changes</button>
                    </form>

                    <hr class="my-4">
                    <div class="mt-4 p-3 border border-danger rounded bg-light">
                        <h5 class="text-danger mb-2">Danger Zone</h5>
                        <p class="small text-muted mb-3">Once you deactivate your account, you will no longer be able to log in or post. This action is reversible by an administrator.</p>
                        <form method="post" action="{{ path('app_profile_deactivate') }}" onsubmit="return confirm('Are you sure you want to deactivate your account? You will be logged out immediately.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('deactivate_account') }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">Deactivate My Account</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="text-center mt-3">
        <a href="{{ path('app_profile', { id: user.id }) }}">Back to profile</a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form');
    const imageInput = document.getElementById('profile_image');
    const imageError = document.getElementById('image-error');
    const saveBtn = document.querySelector('button[type="submit"]');
    const maxSize = 2 * 1024 * 1024; // 2MB

    function validateFile() {
        if (imageInput.files && imageInput.files[0]) {
            const file = imageInput.files[0];
            if (file.size > maxSize) {
                const sizeMB = (file.size / (1024 * 1024)).toFixed(2);
                imageError.innerHTML = `
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-octagon-fill fs-4 me-3"></i>
                        <div>
                            <strong>File too large!</strong><br>
                            Your file is ${sizeMB}MB. The maximum allowed is 2MB.<br>
                            Please choose a smaller image to continue.
                        </div>
                    </div>
                `;
                imageError.style.display = 'block';
                imageInput.classList.add('is-invalid');
                imageInput.value = ''; // Clear the file immediately
                saveBtn.disabled = true;
                return false;
            } else {
                imageError.style.display = 'none';
                imageInput.classList.remove('is-invalid');
                imageInput.classList.add('is-valid');
                saveBtn.disabled = false;
                return true;
            }
        }
        imageError.style.display = 'none';
        imageInput.classList.remove('is-invalid', 'is-valid');
        saveBtn.disabled = false;
        return true;
    }

    imageInput.addEventListener('change', validateFile);

    form.addEventListener('submit', function(e) {
        // Final check before submission
        if (!validateFile()) {
            e.preventDefault();
            alert('Please select a smaller image (max 2MB) before saving changes.');
        }
    });
});
</script>
{% endblock %}
