{% extends "base.html.twig" %}

{% block title %}Email Verification Pending{% endblock %}

{% block content %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">Email Verification Required</h2>
                    
                    <div class="alert alert-warning" role="alert">
                        <p>Your email is not verified yet. Please check your email and click the verification link.</p>
                    </div>

                    <p class="text-center">Once verified, you'll have full access to the forum.</p>

                    <div class="text-center mt-4">
                        <a href="{{ path('app_logout') }}" class="btn btn-secondary">Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}